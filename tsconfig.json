{
  // Strict compiler settings. We type-check only (noEmit); Next.js and tsx handle transpiling.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],

    // Strictness: catch whole classes of bugs at compile time.
    "strict": true,
    "noUncheckedIndexedAccess": true, // arr[i] is T | undefined, forcing explicit handling
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["src", "scripts", "tests", "evals", "*.config.ts", "*.config.js"]
}
