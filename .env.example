# Copy to .env.local and fill in. Never commit .env.local.
# Names only here; real values go in .env.local (local) or Vercel project settings (deployed).

# Meta Model API (Muse Spark): the only model provider
MODEL_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
# META_MODEL_SPARK=muse-spark-1.3

# API protection, per server instance (a serverless deployment has several instances, so this is a
# best-effort guard for the paid model key, not a global quota).
# RATE_LIMIT_PER_MINUTE=12   model routes per client per minute (the plan route gets a third of it)
# MAX_CONCURRENT_RUNS=6      model runs at once on one instance

# Set to true to replay recorded fixtures instead of calling live APIs (no keys needed).
USE_FIXTURES=false

# Set to true to save live model responses as fixtures (src/fixtures). Needs real keys.
RECORD_FIXTURES=false

# debug | info | warn | error
LOG_LEVEL=info

# Seed for the synthetic cohort generator.
COHORT_SEED=1026
