# Copy to .env.local and fill in. Never commit .env.local.
# Names only here; real values go in .env.local (local) or Vercel project settings (deployed).

# Meta Model API (Muse Spark)
MODEL_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
# META_MODEL_SPARK=muse-spark-1.3

# Baseten (Muse Spark Open, open weights, used by the Privacy Guard)
BASETEN_API_KEY=
# OPEN_API_BASE_URL=https://inference.baseten.co/v1
# OPEN_MODEL_ID=meta-models/muse-spark-open-1026

# Set to true to replay recorded fixtures instead of calling live APIs (no keys needed).
USE_FIXTURES=false

# Seed for the synthetic cohort generator.
COHORT_SEED=1026
